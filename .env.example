# =====================================================================
#  LOKAL (npm run dev) — salin ke .env
#  VERCEL             — isi di Project Settings → Environment Variables
#                       (lihat DEPLOY.md)
# =====================================================================

# ---- Database (PostgreSQL) ----
# Lokal (Docker): postgresql://postgres:postgres@localhost:5432/learnhub
# Neon/Supabase : DATABASE_URL = koneksi POOLED (untuk aplikasi)
#                 DIRECT_URL   = koneksi LANGSUNG (untuk prisma migrate)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learnhub"
# DIRECT_URL=""

# ---- Domain ----
# Domain utama (landing + checkout). Default: app di "app.<ROOT_DOMAIN>",
# admin di "admin.<ROOT_DOMAIN>".
#   Lokal     : localhost:3000 → http://localhost:3000, http://app.localhost:3000, http://admin.localhost:3000
#   Domain    : learnhub.id    → https://learnhub.id, https://app.learnhub.id, https://admin.learnhub.id
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# Belum punya domain (mis. *.vercel.app)? Isi host app & admin secara terpisah:
# NEXT_PUBLIC_APP_HOST="learnhub-app.vercel.app"
# NEXT_PUBLIC_ADMIN_HOST="learnhub-admin.vercel.app"

# ---- Pembayaran ----
# "mock" = halaman bayar simulasi. Ganti ke "midtrans"/"xendit" setelah adapter-nya dibuat.
PAYMENT_PROVIDER="mock"
# Secret untuk memverifikasi tanda tangan webhook. Isi string acak panjang.
PAYMENT_WEBHOOK_SECRET="ganti-dengan-string-acak-panjang"
# WAJIB di production (Vercel, npm start) kalau PAYMENT_PROVIDER="mock":
# kode yang harus diketik di halaman bayar simulasi. Tanpa ini checkout ditolak.
# MOCK_PAYMENT_CODE="ganti-dengan-kode-rahasia"

# ---- Email (opsional) ----
# Tanpa RESEND_API_KEY: saat dev link dicetak di terminal; di production tidak terkirim.
# RESEND_API_KEY=""
# EMAIL_FROM="LearnHub <onboarding@resend.dev>"
